<?xml version="1.0" encoding="utf-8"?>
<!-- Фон виджета мужской части GSL (W+M)⁺: графит сверху вниз, тонкая кромка классического золота, скруглённые углы.
     Имя — в конце алфавита: лаунчер помнит виджеты по номерам ресурсов, новый рисунок не должен сдвигать прежние. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#F01A1814" android:endColor="#F00A0A0D" />
    <corners android:radius="22dp" />
    <stroke android:width="1dp" android:color="#99E3C77C" />
</shape>
