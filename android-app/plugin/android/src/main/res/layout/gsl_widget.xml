<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет GSL Woman+: сверху мелко — день и неделя, крупно — задание дня, ниже — утренняя минута и дела на языке
     любви (тексты присылает приложение). Фон — слива с золотой кромкой (gsl_widget_bg). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gsl_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/gsl_widget_bg">

    <TextView
        android:id="@+id/gsl_w_eyebrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GSL Woman+"
        android:textColor="#C98A70"
        android:textSize="11sp"
        android:letterSpacing="0.12"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/gsl_w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#F6DCC4"
        android:textSize="17sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/gsl_w_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:textColor="#E8D2C4"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.15"
        android:ellipsize="end" />
</LinearLayout>
